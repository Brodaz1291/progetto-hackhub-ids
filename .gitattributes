# Text files are stored in the repository with LF endings, whatever the
# core.autocrlf of the machine that commits them.
* text=auto

# The Gradle wrapper script is run by a Unix shell: CRLF endings would break it,
# so it keeps LF in the working copy too.
gradlew text eol=lf
*.sh text eol=lf

# Its Windows counterpart needs the opposite.
gradlew.bat text eol=crlf
*.bat text eol=crlf

# Binary files must never be converted.
*.jar binary
*.vpp binary
