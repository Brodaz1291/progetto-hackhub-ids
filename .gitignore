# Java/Gradle

# Compiled class files
*.class

# Build folders
.gradle/
**/build/
build/

# NOTE: the Gradle wrapper (gradlew, gradlew.bat, gradle/wrapper/gradle-wrapper.jar)
# must be committed so the project builds without a local Gradle install.

# H2 file database (runtime artifacts, must never be committed)
*.mv.db
*.trace.db
*.lock.db

# Logs
*.log

# Temporary files
*.tmp

# OS files
.DS_Store
Thumbs.db

# IDEs
/.idea/
/*.iml
*.ipr
*.iws
/.vscode/
/.settings/
/.project

# Eclipse
.settings/

# IntelliJ
out/

# Tools and local artifacts
/tools/

# Package files - don't track general archives (keep wrapper jar tracked above)
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
target/

# VM crash logs
hs_err_pid*
replay_pid*
