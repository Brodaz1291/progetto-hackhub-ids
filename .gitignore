# Java/Gradle

# Compiled class files
*.class

# Build folders
.gradle/
**/build/
build/

# Gradle wrapper scripts (track these)
gradlew
gradlew.bat
# Ensure the wrapper JAR is tracked even if other JARs are ignored
!gradle/wrapper/gradle-wrapper.jar

# Logs
*.log

# Temporary files
*.tmp

# OS files
.DS_Store
Thumbs.db

# IDEs
/.idea/
/*.iml
*.ipr
*.iws
/.vscode/
/.settings/
/.project

# Eclipse
.settings/

# IntelliJ
out/

# Tools and local artifacts
/tools/

# Package files - don't track general archives (keep wrapper jar tracked above)
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
target/

# VM crash logs
hs_err_pid*
replay_pid*
