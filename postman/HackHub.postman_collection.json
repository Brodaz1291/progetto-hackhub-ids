		{
			"name": "01 Auth",
			"description": "Registration of a brand new user, followed by its login and logout.",
			"item": [
				{
					"name": "Register newcomer",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"the response does not expose the password\", () => pm.expect(pm.response.json()).to.not.have.property(\"password\"));",
									"pm.collectionVariables.set(\"newUserId\", pm.response.json().id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"newcomer\",\n    \"password\": \"password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Unlike login and logout, register reads its parameters from the JSON body."
					}
				},
				{
					"name": "Login newcomer",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"the response does not expose the password\", () => pm.expect(pm.response.json()).to.not.have.property(\"password\"));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/login?username=newcomer&password=password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							],
							"query": [
								{
									"key": "username",
									"value": "newcomer"
								},
								{
									"key": "password",
									"value": "password"
								}
							]
						}
					}
				},
				{
					"name": "Logout newcomer",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/logout?userId={{newUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"logout"
							],
							"query": [
								{
									"key": "userId",
									"value": "{{newUserId}}"
								}
							]
						},
						"description": "Uses the id returned by the registration, never a hardcoded one."
					}
				}
			]
		},
		{
			"name": "02 Hackathon",
			"description": "Creation of a hackathon by organizer1 and update of its information while registrations are still open.",
			"item": [
				{
					"name": "Create hackathon",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"the hackathon is open to registrations\", () => pm.expect(pm.response.json().state).to.eql(\"REGISTRATION\"));",
									"pm.collectionVariables.set(\"hackathonId\", pm.response.json().id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"HackHub Autumn Challenge\",\n    \"rules\": \"Teams build a working prototype in 48 hours. Only open source libraries are allowed.\",\n    \"location\": \"Camerino, Polo Informatico\",\n    \"prize\": 5000,\n    \"registrationDeadline\": \"2026-09-01T23:59:00\",\n    \"startDate\": \"2026-09-15T09:00:00\",\n    \"endDate\": \"2026-09-17T18:00:00\",\n    \"maxTeamSize\": 4,\n    \"judgeId\": {{judgeId}},\n    \"mentorIds\": [{{mentorId1}}, {{mentorId2}}]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/hackathons?organizerId={{organizerId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"hackathons"
							],
							"query": [
								{
									"key": "organizerId",
									"value": "{{organizerId}}"
								}
							]
						},
						"description": "The staff is taken from the ids saved in 00 Setup. The dates respect registrationDeadline <= startDate < endDate, otherwise the creation is rejected."
					}
				},
				{
					"name": "Update hackathon",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"the new name is in the response\", () => pm.expect(pm.response.json().name).to.eql(\"HackHub Autumn Challenge 2026\"));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"HackHub Autumn Challenge 2026\",\n    \"rules\": \"Teams build a working prototype in 48 hours. Only open source libraries are allowed, and the repository must be public.\",\n    \"location\": \"Camerino, Aula Magna\",\n    \"prize\": 6000,\n    \"registrationDeadline\": \"2026-09-05T23:59:00\",\n    \"startDate\": \"2026-09-20T09:00:00\",\n    \"endDate\": \"2026-09-22T18:00:00\",\n    \"maxTeamSize\": 5\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/hackathons/{{hackathonId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"hackathons",
								"{{hackathonId}}"
							]
						},
						"description": "The staff is not editable here: the body carries only the information proper to the hackathon."
					}
				}
			]
		},
		{
			"name": "03 Team",
			"description": "Creation of a team by member1, who becomes its first member.",
			"item": [
				{
					"name": "Create team",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"the creator is the first member\", () => pm.expect(pm.response.json().memberUsernames).to.include(\"member1\"));",
									"pm.collectionVariables.set(\"teamId\", pm.response.json().id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Byte Runners\",\n    \"iban\": \"IT60X0542811101000000123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/teams?creatorId={{memberId1}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"teams"
							],
							"query": [
								{
									"key": "creatorId",
									"value": "{{memberId1}}"
								}
							]
						},
						"description": "The creator must not take part in anything else yet: member1 is free, while organizer1, judge1 and the mentors are already staff of the hackathon."
					}
				}
			]
		},
		{
			"name": "04 Staff",
			"description": "Changes to the staff of the hackathon created in 02: a mentor is added and removed, then the judge is replaced. All three requests use member3, the last free user of the seeder.",
			"item": [
				{
					"name": "Add mentor",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"member3 is the new mentor\", () => pm.expect(pm.response.json().username).to.eql(\"member3\"));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/hackathons/{{hackathonId}}/mentors?username=member3",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"hackathons",
								"{{hackathonId}}",
								"mentors"
							],
							"query": [
								{
									"key": "username",
									"value": "member3"
								}
							]
						},
						"description": "member3 is the only user still free at this point: the others are already staff of the hackathon or members of the team created in 03. The response describes the user who became a mentor, not the participation."
					}
				},
				{
					"name": "Remove mentor",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/hackathons/{{hackathonId}}/mentors?username=member3",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"hackathons",
								"{{hackathonId}}",
								"mentors"
							],
							"query": [
								{
									"key": "username",
									"value": "member3"
								}
							]
						},
						"description": "The hackathon has three mentors after the previous request, so member3 is not the last one and can be removed. The response is empty."
					}
				},
				{
					"name": "Replace judge",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"member3 is the new judge\", () => pm.expect(pm.response.json().username).to.eql(\"member3\"));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/hackathons/{{hackathonId}}/judge?username=member3",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"hackathons",
								"{{hackathonId}}",
								"judge"
							],
							"query": [
								{
									"key": "username",
									"value": "member3"
								}
							]
						},
						"description": "It runs after the removal on purpose: member3 becomes free again only once the mentor participation is gone, otherwise the replacement would be refused."
					}
				}
			]
		},
		{
			"name": "05 Invitations",
			"description": "member1 invites member2 into the team created in 03, and member2 accepts. The three requests go through TeamFacade, which coordinates the state of the invitation with the membership.",
			"item": [
				{
					"name": "Send invitation",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"the invitation is for the team of member1\", () => pm.expect(pm.response.json().teamName).to.eql(\"Byte Runners\"));",
									"pm.test(\"member1 is the sender\", () => pm.expect(pm.response.json().senderUsername).to.eql(\"member1\"));",
									"pm.test(\"the invitation is pending\", () => pm.expect(pm.response.json().status).to.eql(\"PENDING\"));",
									"pm.collectionVariables.set(\"invitationId\", pm.response.json().id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/teams/{{teamId}}/invitations?username=member2&senderId={{memberId1}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"teams",
								"{{teamId}}",
								"invitations"
							],
							"query": [
								{
									"key": "username",
									"value": "member2"
								},
								{
									"key": "senderId",
									"value": "{{memberId1}}"
								}
							]
						},
						"description": "member1 is the only member of the team, so it is the only user who can invite; member2 is free, as neither 03 nor 04 has used it."
					}
				},
				{
					"name": "Get invitations",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"member2 has at least one invitation\", () => pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty);",
									"pm.test(\"the invitation comes from the right team\", () => pm.expect(pm.response.json()[0].teamName).to.eql(\"Byte Runners\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/teams/invitations?userId={{memberId2}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"teams",
								"invitations"
							],
							"query": [
								{
									"key": "userId",
									"value": "{{memberId2}}"
								}
							]
						},
						"description": "The list holds the invitations received by member2 and still to be answered, not those sent by a team: this is why the path carries no team id."
					}
				},
				{
					"name": "Accept invitation",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"the invitation is accepted\", () => pm.expect(pm.response.json().status).to.eql(\"ACCEPTED\"));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/teams/invitations/{{invitationId}}?userId={{memberId2}}",
							"host": [
								"{{baseUrl}}"
							],
