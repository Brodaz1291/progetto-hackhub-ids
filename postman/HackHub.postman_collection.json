{
	"info": {
		"name": "HackHub",
		"description": "Happy paths of the HackHub REST API. Run the folders in order, from 00 Setup down: every request that creates something saves the generated id in a collection variable, so no id has to be typed by hand.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "00 Setup",
			"description": "Logs in the development users seeded at startup and stores their ids. These are the actors of every following request.",
			"item": [
				{
					"name": "Login organizer1",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 200\", () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set(\"organizerId\", pm.response.json().id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/login?username=organizer1&password=password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							],
							"query": [
								{
									"key": "username",
									"value": "organizer1"
								},
								{
									"key": "password",
									"value": "password"
								}
							]
						},
						"description": "Credentials travel in the query string: the endpoint reads them with @RequestParam."
					}
				},
